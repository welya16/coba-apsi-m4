generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model aktivitas_owner {
  id_akun    String @db.VarChar(20)
  id_laporan String @db.VarChar(20)
  akun       akun   @relation(fields: [id_akun], references: [id_akun], onDelete: Cascade) // <-- 2. Ditambahkan relasi ke akun
  laporan    laporan @relation(fields: [id_laporan], references: [id_laporan], onDelete: Cascade)

  @@id([id_akun, id_laporan])
}

model akun {
  id_akun         String            @id @db.VarChar(20)
  username        String            @unique @db.VarChar(50)
  password        String            @db.VarChar(100)
  nama_lengkap    String            @db.VarChar(100)
  role            String            @db.VarChar(30)
  aktivitas_owner aktivitas_owner[] // <-- 3. Ditambahkan relasi balik
}

model alamat {
  id_alamat                          String     @id @db.VarChar(20)
  id_pelanggan                       String     @db.VarChar(20)
  alamat_jalan                       String     @db.VarChar(255)
  alamat_rt                          String?    @db.VarChar(3)
  alamat_rw                          String?    @db.VarChar(3)
  kode_pos                           String?    @db.VarChar(10)
  pelanggan                          pelanggan  @relation(fields: [id_pelanggan], references: [id_pelanggan], onDelete: Cascade)
  kode_pos_alamat_kode_posTokode_pos kode_pos?  @relation("alamat_kode_posTokode_pos", fields: [kode_pos], references: [kode_pos])
}

model detail_pesanan {
  id_detail          String   @id @db.VarChar(20)
  id_pesanan         String   @db.VarChar(30)
  id_produk          String   @db.VarChar(20)
  ukuran             String?  @db.VarChar(10)
  jumlah             Int
  spesifikasi_desain String?  @db.VarChar(150)
  file_desain        String?  @db.VarChar(150)
  warna              String?  @db.VarChar(20)
  harga_satuan       Decimal  @db.Decimal(12, 2)
  pesanan            pesanan  @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)
  produk             produk   @relation(fields: [id_produk], references: [id_produk])
}

model kode_pos {
  kode_pos                           String   @id @db.VarChar(10)
  kelurahan                          String?  @db.VarChar(100)
  kecamatan                          String?  @db.VarChar(100)
  kota                               String?  @db.VarChar(100)
  provinsi                           String?  @db.VarChar(100)
  alamat_alamat_kode_posTokode_pos   alamat[] @relation("alamat_kode_posTokode_pos")
}

model kritik_saran {
  id_kritik       String    @id @db.VarChar(20)
  id_pelanggan    String    @db.VarChar(20)
  id_pesanan      String    @db.VarChar(30)
  isi             String
  rating          Int?      @db.SmallInt
  tgl_kritik      DateTime  @db.Date
  tanggapan_admin String?
  pelanggan       pelanggan @relation(fields: [id_pelanggan], references: [id_pelanggan], onDelete: Cascade)
  pesanan         pesanan   @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)
}

model laporan {
  id_laporan       String            @id @db.VarChar(20)
  periode_bulan    Int               @db.SmallInt
  periode_tahun    Int               @db.SmallInt
  tgl_laporan      DateTime          @db.Date
  total_pendapatan Decimal           @db.Decimal(14, 2)
  aktivitas_owner  aktivitas_owner[]
}

model notifikasi {
  id_notifikasi  String   @id @db.VarChar(20)
  id_akun        String   @db.VarChar(20)
  id_pesanan     String   @db.VarChar(30)
  pesan          String
  tgl_notifikasi DateTime @db.Date
  status_baca    Int?     @default(0) @db.SmallInt
  pesanan        pesanan  @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)
}

model pelanggan {
  id_pelanggan String         @id @db.VarChar(20)
  id_akun      String         @db.VarChar(20)
  jenis_kelamin String?       @db.VarChar(20)
  no_hp        String         @db.VarChar(20)
  alamat       alamat[]
  kritik_saran kritik_saran[]
  pesanan      pesanan[]
}

model pembayaran {
  id_pembayaran     String    @id @db.VarChar(20)
  id_pesanan        String    @db.VarChar(30)
  tgl_bayar         DateTime? @db.Date
  jenis_bayar       String?   @db.VarChar(30)
  metode_bayar      String?   @db.VarChar(30)
  jumlah_bayar      Decimal?  @db.Decimal(12, 2)
  bukti_bayar       String?   @db.VarChar(150)
  status_pembayaran String?   @db.VarChar(40)
  pesanan           pesanan   @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)
}

model pengiriman {
  id_pengiriman       String    @id @db.VarChar(20)
  id_pesanan          String?   @db.VarChar(30)
  id_kurir            String?   @db.VarChar(20)
  alamat_tujuan_jalan String?   @db.VarChar(255)
  alamat_tujuan_rt    String?   @db.VarChar(3)
  alamat_tujuan_rw    String?   @db.VarChar(3)
  kode_pos            String?   @db.VarChar(10)
  no_antrian          Int?
  tgl_kirim           DateTime? @db.Date
  estimasi_tiba       DateTime? @db.Date
  status_pengiriman   String?   @db.VarChar(40)
}

model perubahan_pesanan {
  id_perubahan        String    @id @db.VarChar(20)
  id_pesanan          String?   @db.VarChar(30)
  id_admin            String?   @db.VarChar(20)
  tgl_permintaan      DateTime? @db.Date
  deskripsi_perubahan String?
  status_perubahan    String?   @db.VarChar(30)
}

model pesanan {
  id_pesanan         String           @id @db.VarChar(30)
  id_pelanggan       String?          @db.VarChar(20)
  id_admin           String           @db.VarChar(20)
  tgl_konfirmasi     DateTime?        @db.Date
  total_harga        Decimal          @db.Decimal(12, 2)
  status_pesanan     String           @db.VarChar(40)
  tgl_pesan          DateTime         @db.Date
  tgl_butuh          DateTime?        @db.Date
  metode_pengambilan String           @db.VarChar(20)
  catatan            String?          @db.VarChar(255)
  detail_pesanan     detail_pesanan[]
  kritik_saran       kritik_saran[]
  notifikasi         notifikasi[]
  pembayaran         pembayaran[]
  pelanggan          pelanggan?       @relation(fields: [id_pelanggan], references: [id_pelanggan])
  produksi           produksi[]
}

model produk {
  id_produk       String           @id @db.VarChar(20)
  nama_produk     String           @db.VarChar(50)
  jenis           String           @db.VarChar(50)
  harga_dasar     Decimal          @db.Decimal(12, 2)
  deskripsi       String?
  bahan           String?          @db.VarChar(100)
  status_tersedia String?          @db.VarChar(30)
  detail_pesanan  detail_pesanan[]
}

model produksi {
  id_produksi          String    @id @db.VarChar(20)
  id_pesanan           String    @db.VarChar(30)
  id_petugas           String    @db.VarChar(20)
  tgl_mulai            DateTime? @db.Date
  tgl_estimasi_selesai DateTime? @db.Date
  status_produksi      String?   @db.VarChar(40)
  pesanan              pesanan   @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)
}